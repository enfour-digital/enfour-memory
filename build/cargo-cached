#!/usr/bin/env python3
"""Run Cargo, drain compiler cache writes, and restore output ownership."""
import os
from pathlib import Path
import subprocess
import sys


def call(arguments):
    result = subprocess.run(arguments)
    return result.returncode if result.returncode >= 0 else 128 - result.returncode


def main():
    if os.environ.get("ENFOUR_CACHE_MODE") == "disk":
        os.environ.pop("SCCACHE_REDIS_ENDPOINT", None)
        os.environ["SCCACHE_DIR"] = "/cache/sccache"
    cached = bool(os.environ.get("RUSTC_WRAPPER"))
    status = 0
    started = False
    try:
        if cached:
            status = call(["sccache", "--start-server"])
            if status:
                return status
            started = True
        status = call(["cargo", *sys.argv[1:]])
    finally:
        if started:
            # Cleanup failures cannot hide the original Cargo failure.
            for arguments in (["sccache", "--show-stats"], ["sccache", "--stop-server"]):
                cleanup = call(arguments)
                status = status or cleanup
        owner = os.environ.get("LOCAL_OWNER")
        if owner:
            for path in (Path("/workspace/target"), Path("/workspace/Cargo.lock")):
                if path.exists():
                    cleanup = call(["chown", "-R", owner, str(path)])
                    status = status or cleanup
    return status


if __name__ == "__main__":
    raise SystemExit(main())
