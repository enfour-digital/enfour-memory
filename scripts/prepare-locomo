#!/usr/bin/env python3
"""Fetch the pinned LoCoMo dataset. Keep relevance labels external to retrieval inputs."""
import argparse
import hashlib
import json
from pathlib import Path
import urllib.request

REVISION = '3eb6f2c585f5e1699204e3c3bdf7adc5c28cb376'
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--output", type=Path, default=Path(__file__).resolve().parent.parent / "bench/locomo")
root = parser.parse_args().output
root.mkdir(parents=True, exist_ok=True)
for name in ['locomo10.json', 'LICENSE.txt']:
    target = root / name
    if not target.exists():
        upstream = 'data/' + name if name.endswith('.json') else name
        url = f'https://raw.githubusercontent.com/snap-research/locomo/{REVISION}/{upstream}'
        target.write_bytes(urllib.request.urlopen(url, timeout=60).read())
assert hashlib.sha256((root/'locomo10.json').read_bytes()).hexdigest() == '79fa87e90f04081343b8c8debecb80a9a6842b76a7aa537dc9fdf651ea698ff4', 'dataset checksum mismatch'
data = json.loads((root/'locomo10.json').read_text())
ordered = sorted(data, key=lambda x: hashlib.sha256(x['sample_id'].encode()).hexdigest())
dev = {x['sample_id'] for x in ordered[:2]}
corpus, queries, labels, excluded = [], {'dev': [], 'test': []}, [], []
for conversation in data:
    scope = 'locomo:' + conversation['sample_id']
    sessions = conversation['conversation']
    valid = set()
    for session, turns in sessions.items():
        if not session.startswith('session_') or not isinstance(turns, list):
            continue
        date = sessions.get(session+'_date_time', '')
        for turn in turns:
            key = turn['dia_id']
            assert key not in valid
            valid.add(key)
            # Only original dialogue and released image captions enter the index.
            # No QA labels, answers, generated observations or event summaries.
            content = f"{turn['speaker']}: {turn['text']}"
            if turn.get('blip_caption'):
                content += '\nImage caption: ' + turn['blip_caption']
            corpus.append(dict(scope=scope,key=key,title=f"{turn['speaker']} · {date}",
                               content=content,kind='fact',source=f'locomo@{REVISION}:{scope}/{key}',
                               expected_revision=0))
    for index, question in enumerate(conversation['qa']):
        ident = f"{conversation['sample_id']}/{index}"
        gold = sorted(set(question.get('evidence', [])))
        reason = 'adversarial' if question['category'] == 5 else 'missing_or_invalid_evidence' if not gold or not set(gold) <= valid else None
        if reason:
            excluded.append(dict(id=ident,reason=reason,category=question['category']))
            continue
        split = 'dev' if conversation['sample_id'] in dev else 'test'
        queries[split].append(dict(id=ident,scope=scope,query=question['question']))
        labels.append(dict(id=ident,scope=scope,gold=gold,category=question['category'],split=split))
def write(name, rows):
    (root/name).write_text(''.join(json.dumps(row,ensure_ascii=False)+'\n' for row in rows))
write('corpus.jsonl',corpus)
for split, rows in queries.items(): write(split+'.queries.jsonl',rows)
write('labels.jsonl',labels)
write('excluded.jsonl',excluded)
manifest = dict(upstream='https://github.com/snap-research/locomo',revision=REVISION,
                license='CC-BY-NC-4.0',source_sha256=hashlib.sha256((root/'locomo10.json').read_bytes()).hexdigest(),
                development_conversations=sorted(dev),documents=len(corpus),
                queries={k:len(v) for k,v in queries.items()},excluded=len(excluded),
                hashes={name:hashlib.sha256((root/name).read_bytes()).hexdigest() for name in ['corpus.jsonl','dev.queries.jsonl','test.queries.jsonl','labels.jsonl','excluded.jsonl']})
(root/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
print(json.dumps(manifest,indent=2))
